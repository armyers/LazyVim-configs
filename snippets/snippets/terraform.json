{
  "z-locals": {
    "prefix": "z-locals",
    "body": [
      "locals {",
      "  namespace = \"${1:NAMESPACE}\"",
      "  service   = \"${2:SERVICE}\"",
      "  basename  = module.label.names.default",
      "",
      "  common_tags = module.label.tags.default",
      "}"
    ]
  },
  "z-module-abbrev": {
    "prefix": [
      "z-abbrev",
      "z-module-abbrev"
    ],
    "body": [
      "module \"abbrev\" {",
      "  source = \"git@github.com:Katlean/terraform-aws-modules.git//aws_abbrev\"",
      "  # NOTE: this is here for local testing/debugging the module",
      "  # source = \"../../terraform-aws-modules/aws_abbrev\"",
      "}",
      ""
    ]
  },
  "z-data-vpc": {
    "prefix": "z-data-vpc",
    "body": [
      "data \"aws_vpc\" \"${1:this}\" {",
      "  tags = {",
      "    Name = ${2:local.basename}",
      "  }",
      "}",
      ""
    ]
  },
  "z-defaults": {
    "prefix": "z-defaults",
    "body": [
      "module \"defaults\" {",
      "  source = \"../../modules/defaults\"",
      "}",
      ""
    ]
  },
  "z-waf-ipsets-data": {
    "prefix": "z-waf-ipsets-data",
    "body": [
      "module \"waf_ipsets_data\" {",
      "  source = \"git@github.com:Katlean/terraform-aws-modules//common-infra/data/waf-ipsets\"",
      "  # NOTE: this is here for local testing/debugging the module",
      "  # source      = \"../../../../terraform-aws-modules/common-infra/data/waf-ipsets\"",
      "  environment = var.environment",
      "}",
      ""
    ]
  },
  "z-providers": {
    "prefix": [
      "z-providers",
      "z-versions"
    ],
    "body": [
      "terraform {",
      "  required_version = \"${1:= 1.7.5}\"",
      "",
      "  required_providers {",
      "    aws = {",
      "      source  = \"hashicorp/aws\"",
      "      version = \"~> ${2:5.0}\"",
      "    }",
      "  }",
      "",
      "  backend \"s3\" {}",
      "}",
      "",
      "provider \"aws\" {",
      "  region = var.region",
      "",
      "  default_tags {",
      "    tags = local.common_tags",
      "  }",
      "}"
    ]
  },
  "z-labels": {
    "prefix": [
      "z-labels",
      "z-module-labels"
    ],
    "body": [
      "###########################################################################",
      "# default labels set on the provider in each stack's providers.tf",
      "module \"label\" {",
      "  source              = \"git@github.com:Katlean/terraform-zestai-label.git?ref=${1:v3.0.2}\"",
      "  namespace           = ${2:local.namespace}",
      "  environment         = ${3:var.environment}",
      "  service             = ${4:local.service}",
      "}",
      ""
    ]
  },
  "z-vpc-data": {
    "prefix": [
      "z-vpc-data",
      "z-module-vpc-data"
    ],
    "body": [
      "module \"vpc_data\" {",
      "  source = \"git@github.com:Katlean/terraform-aws-modules//common-infra/data/vpc\"",
      "  # NOTE: this is here for local testing/debugging the module",
      "  # source = \"../../../../../terraform-aws-modules/common-infra/data/vpc\"",
      "  region          = var.region",
      "  environment     = var.environment",
      "  vpc_name_prefix = local.vpc_name_prefix",
      "  lookup_flow_logs_bucket = ${1:false}",
      "}",
      ""
    ]
  },
  "z-common-tags": {
    "prefix": [
      "z-common-tags"
    ],
    "body": [
      "common_tags = module.label.tags.default"
    ]
  },
  "z-variables": {
    "prefix": "z-variables",
    "body": [
      "variable \"region\" {",
      "  description = \"AWS region\"",
      "  type = string",
      "}",
      "",
      "variable \"environment\" {",
      "  description = \"environment level; eg, dev, qa, stage, prod\"",
      "  type = string",
      "}",
      "",
      "locals {",
      "  namespace = \"${1:NAMESPACE}\"",
      "  service   = \"${2:SERVICE}\"",
      "  basename  = module.label.names.default",
      "",
      "  common_tags = module.label.tags.default",
      "}"
    ]
  },
  "z-common-data": {
    "prefix": [
      "z-common-data",
      "z-module-common-data"
    ],
    "body": [
      "module \"common_data\" {",
      "  source = \"git@github.com:Katlean/terraform-aws-modules//common-data\"",
      "  # NOTE: this is here for local testing/debugging the module",
      "  # source = \"../../../../terraform-aws-modules/common-data\"",
      "}",
      ""
    ]
  }
}
